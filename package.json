{
  "name": "ng-click-outside",
  "version": "0.0.0",
  "description": "Angular directive for handling click events outside an element.",
  "author": "Eugene Cheung, Manuel Schmidt",
  "homepage": "https://kr0san89.github.io/ng-click-outside/",
  "bugs": {
    "url": "https://github.com/Kr0san89/ng-click-outside/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:demo": "ng build demo --base-href=/ng-click-outside/",
    "build:lib": "ng build ng-click-outside2 && cp README.md dist/ng-click-outside2",
    "publish:lib": "cd dist/ng-click-outside2 && npm publish",
    "publish:next:lib": "cd dist/ng-click-outside2 && npm publish --tag alpha",
    "watch": "ng build --watch --configuration development",
    "test": "jest --config projects/ng-click-outside2/jest.config.ts",
    "lint": "ng lint"
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.7.0",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "jest-preset-angular": {
      "@angular/compiler": "~22.0.0",
      "@angular/compiler-cli": "~22.0.0",
      "@angular/common": "~22.0.0",
      "@angular/platform-browser-dynamic": "~22.0.0",
      "@angular/platform-browser": "~22.0.0",
      "@angular/core": "~22.0.0"
    }
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-eslint/builder": "21.0.1",
    "@angular-eslint/eslint-plugin": "21.0.1",
    "@angular-eslint/eslint-plugin-template": "21.0.1",
    "@angular-eslint/schematics": "21.0.1",
    "@angular-eslint/template-parser": "21.0.1",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "browser-sync": "^3.0.0",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "^16.1.5",
    "ng-packagr": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
